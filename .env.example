# Copy to .env and adjust for your local PostgreSQL setup.
# Docker Compose defaults are shown below.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=business_management
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT (development only — change in production)
JWT_SECRET=change-this-development-secret-key-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API URL (frontend/.env)
# VITE_API_BASE_URL=http://localhost:8080/api
